{
  "name": "moonfod",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/dev-server.py",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-site.mjs",
