{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moonfod",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "moonfod.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
